# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Neon → your project → Connection Details → "Pooled connection". Use the
# pooled URI (the host with `-pooler` in it), not the direct one — the app runs
# with prepared statements off to suit the pooler.
# Neon is deliberate: free Supabase projects fully pause after ~a week idle and
# need a manual unpause, whereas Neon auto-suspends and wakes in <500ms. A
# journal that sits untouched over a quiet fortnight needs the latter.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Sign-in with Google (required in any deployed environment)
# ---------------------------------------------------------------------------
# Google Cloud console -> APIs & Services -> Credentials -> Create OAuth client
# ID -> Web application. Add this exact authorised redirect URI:
#
#   https://<your-host>/api/auth/google/callback
#
# If BOTH of these are unset the app runs as a single local account with no
# sign-in at all — fine on localhost, never acceptable on a public host.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Google account that owns this journal. It is the one that inherits every
# trade logged before sign-in existed, and without it NOBODY can sign in — the
# app refuses rather than letting the first stranger who finds the URL claim
# your record.
OWNER_EMAIL=

# Optional. Anyone else allowed in, comma separated. Each gets their own empty
# journal; they can never see yours. There is no self-service sign-up, so this
# list plus OWNER_EMAIL is the complete set of people with access.
ALLOWED_EMAILS=

# Optional. Only needed when the browser reaches the app on a different origin
# than the server sees (an external proxy). Otherwise the redirect URI is
# derived from the request, which is correct on Render.
PUBLIC_URL=

# Signs the session cookie. Any long random string; regenerating it just logs
# you out. Omit locally and a throwaway one is generated per boot.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# AI (set at least one)
# ---------------------------------------------------------------------------
# Powers screenshot parsing and rationale tagging. If both are present,
# Anthropic wins — Claude reads prices off a chart axis more reliably.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
