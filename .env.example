# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → "Transaction
# pooler". Use the pooler URI (port 6543), not the direct connection.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth (required in any deployed environment)
# ---------------------------------------------------------------------------
# The single shared password for the journal. If this is unset the API is
# COMPLETELY OPEN — fine on localhost, never acceptable on a public host.
APP_PASSWORD=

# Signs the session cookie. Any long random string; regenerating it just logs
# you out. Omit locally and a throwaway one is generated per boot.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# AI (set at least one)
# ---------------------------------------------------------------------------
# Powers screenshot parsing and rationale tagging. If both are present,
# Anthropic wins — Claude reads prices off a chart axis more reliably.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
